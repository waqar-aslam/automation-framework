<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Automation Test Suite" verbose="1" parallel="tests" thread-count="2">

    <!-- Test Listeners -->
    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
        <listener class-name="com.framework.listeners.AllureListener"/>
    </listeners>

    <test name="Chrome Tests - Login">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.framework.testcases.LoginTest"/>
        </classes>
    </test>

    <test name="Chrome Tests - Home">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.framework.testcases.HomeTest"/>
        </classes>
    </test>

    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.framework.testcases.LoginTest"/>
            <class name="com.framework.testcases.HomeTest"/>
        </classes>
    </test>

    <!-- Smoke Test -->
    <test name="Smoke Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.framework.testcases.LoginTest"/>
            <class name="com.framework.testcases.HomeTest"/>
        </classes>
    </test>

    <!-- Regression Test -->
    <test name="Regression Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.framework.testcases.LoginTest"/>
        </classes>
    </test>

    <!-- Cross Browser Test -->
    <test name="Edge Browser Test">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.framework.testcases.LoginTest">
                <methods>
                    <include name="testValidLogin"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>